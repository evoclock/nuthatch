# nuthatch-specific: inputs payloads stay on disk but out of git.
# The inputs/ directory itself is shipped (so the structure is
# discoverable) but the PDFs / extracted text / chunks / graph
# artifacts are too big and too personal to commit. Use a separate
# backup target (e.g. borg) for these.
inputs/**/*.pdf
inputs/**/*.txt
inputs/**/*.json
inputs/**/extracted/
inputs/**/chunks/
inputs/**/.kg/

# Build artifacts from ingest pipeline (when those land).
.nuthatch-cache/
pipeline_output/
HANDOVER.md
DECISIONS.md
SPRINT_PLAN.md
OPERATIONS.md

# Internal-only architecture docs (use kestrel codename; do not publish)
docs/architecture/kestrel_*.md
docs/architecture/kestrel_vs_nuthatch.md
docs/architecture/deferred_*.md
docs/architecture/eval_strategy_*.md
